<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="600.0" prefWidth="900.0" styleClass="login-root" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.library.LoginController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="420.0"
            spacing="12.0" styleClass="login-card">
         <children>
            <Label styleClass="login-title" text="Library Management System" />
            <Label styleClass="login-subtitle" text="Librarian Login">
               <VBox.margin>
                  <Insets bottom="8.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="txtUsername" promptText="Username" />
            <PasswordField fx:id="pwdPassword" promptText="Password" />
            <Label fx:id="lblError" styleClass="error-label" wrapText="true" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnLogin" defaultButton="true" maxWidth="1.7976931348623157E308"
                          onAction="#handleLogin" styleClass="primary-button" text="Login"
                          HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnClear" maxWidth="1.7976931348623157E308"
                          onAction="#handleClear" styleClass="secondary-button" text="Clear"
                          HBox.hgrow="ALWAYS" />
               </children>
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
            </HBox>
            <Label styleClass="login-hint" text="Demo credentials — admin / admin123">
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
            </Label>
         </children>
         <padding>
            <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
